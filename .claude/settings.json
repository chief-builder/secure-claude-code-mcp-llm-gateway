{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run python -m pytest *)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.token)",
      "Read(**/*.sqlite3)",
      "Read(**/.env)",
      "Read(**/.env.*/**)",
      "Read(~/secure-claude-lab/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-force-push.sh"
          }
        ]
      }
    ]
  }
}
